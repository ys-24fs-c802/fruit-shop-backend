<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.cofile.fruitshop.backend.admin.mapper.ItemMapper">
    <insert id="insertItem" parameterType="kr.co.cofile.fruitshop.backend.admin.dto.ItemDto">
        INSERT INTO items (name) VALUES (#{name});
    </insert>
    <select id="selectItemById" resultType="kr.co.cofile.fruitshop.backend.admin.dto.ItemDto">
        SELECT id, name FROM items WHERE id = #{id};
    </select>
</mapper>